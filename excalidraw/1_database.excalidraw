    {
      "id": "eJt5qkXPG0RCZLLqSla0f",
      "type": "text",
      "x": 873.4995880126953,
      "y": 193.5,
      "width": 396.0008239746094,
      "height": 580,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1687721794,
      "version": 749,
      "versionNonce": 732782474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785655075868,
      "link": null,
      "locked": false,
      "text": "We have to add Schema alongside models.\n\nUser inculdes:\n1.ID\n2.Name\n3.Username\n4.Password\n5.Active\n\nFirst Table is Called Chats, it includes:\n1.ID\n2. User_ID\n3. Chat Name\n4.Created_at\n\nThen we will have user messages that include:\n1.ID\n2. User_ID\n3.Chat_ID\n4.Content\n5.Created_at\n\nThen we will have assistant messages that\ninclude:\n1.ID\n2.Model_Name\n3.Chat_ID\n4.Content\n5.Created_at",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "WHloLvhtodl-oGKKKTEEK",
      "originalText": "We have to add Schema alongside models.\n\nUser inculdes:\n1.ID\n2.Name\n3.Username\n4.Password\n5.Active\n\nFirst Table is Called Chats, it includes:\n1.ID\n2. User_ID\n3. Chat Name\n4.Created_at\n\nThen we will have user messages that include:\n1.ID\n2. User_ID\n3.Chat_ID\n4.Content\n5.Created_at\n\nThen we will have assistant messages that include:\n1.ID\n2.Model_Name\n3.Chat_ID\n4.Content\n5.Created_at",
      "autoResize": true,
      "lineHeight": 1.25
    },
