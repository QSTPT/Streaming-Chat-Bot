      "updated": 1785589409797,
      "link": null,
      "locked": false,
      "text": "Instead of saving user request and assistant's answer\ninside history = [], I will add a postgresql database\nand then save everyting inside different tables.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XywSSOFvaACKdSL2ExQ8u",
      "originalText": "Instead of saving user request and assistant's answer inside history = [], I will add a postgresql database and then save everyting inside different tables.",
      "autoResize": true,
      "lineHeight": 1.25
    },
