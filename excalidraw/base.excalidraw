    {
      "id": "eJt5qkXPG0RCZLLqSla0f",
      "type": "text",
      "x": 873.4995880126953,
      "y": 193.5,
      "width": 396.0008239746094,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
